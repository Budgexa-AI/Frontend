# ============================================================
# Environment Variables Configuration
# ============================================================

# Backend API base URL (used server-side by Next.js proxy route /api/v1/* and SSR fetchers)
# e.g. https://rayotypebackend-production.up.railway.app or http://localhost:3001
BACKEND_URL=http://localhost:3001

# Public backend URL (used by client-side browser navigation for Google OAuth redirect)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Public app frontend URL (used server-side to build absolute URLs during SSR/prerender)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dashboard URL for post-login/signup redirects
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000/product/dashboard

# JWT Secret for middleware token signature verification
JWT_SECRET=your_jwt_secret_here
